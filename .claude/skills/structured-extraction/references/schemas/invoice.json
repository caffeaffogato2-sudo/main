{
  "title": "請求書・見積書・領収書",
  "type": "object",
  "required": ["document_type", "document_number", "issue_date", "issuer", "recipient", "line_items", "subtotal", "tax", "total", "currency"],
  "properties": {
    "document_type": {"type": "string", "enum": ["invoice", "quotation", "receipt", "other"]},
    "document_number": {"type": ["string", "null"], "description": "請求書番号など"},
    "issue_date": {"type": ["string", "null"], "format": "date"},
    "due_date": {"type": ["string", "null"], "format": "date", "description": "支払期限"},
    "issuer": {"type": ["string", "null"], "description": "発行者（会社名）"},
    "issuer_registration_number": {"type": ["string", "null"], "description": "適格請求書発行事業者登録番号 T+13桁"},
    "recipient": {"type": ["string", "null"], "description": "宛先"},
    "line_items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["description", "quantity", "unit_price", "amount"],
        "properties": {
          "description": {"type": "string"},
          "quantity": {"type": ["number", "null"]},
          "unit_price": {"type": ["number", "null"]},
          "amount": {"type": ["number", "null"]},
          "tax_rate": {"type": ["number", "null"], "description": "0.1 / 0.08 など"}
        }
      }
    },
    "subtotal": {"type": ["number", "null"]},
    "tax": {"type": ["number", "null"]},
    "total": {"type": ["number", "null"]},
    "currency": {"type": "string", "description": "JPY / USD など"},
    "bank_account": {"type": ["string", "null"]},
    "_notes": {"type": "array", "items": {"type": "string"}}
  }
}
